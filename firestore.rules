rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny All fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@digishop.com' ||
        request.auth.token.email == 'elvisioleng@gmail.com' ||
        request.auth.token.email == 'lemaxshop01@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() || 
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        // Public lookup with downloadToken matching
        (resource.data.downloadToken != null && resource.data.downloadToken == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow delete: if isAdmin();
    }

    // Coupons collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Advertisements collection
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Site settings collection (restricted to admin for security)
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Email notifications audit log collection
    match /email_notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
